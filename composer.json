{
    "name": "tikhomirov/moontrail",
    "description": "MoonShine Logs: advanced logging with visual diffs, model versioning, and transactional rollback",
    "homepage": "https://github.com/tikhomirov/moontrail",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksey Tikhomirov",
            "homepage": "https://github.com/tikhomirov"
        }
    ],
    "keywords": [
        "moonshine",
        "laravel",
        "activity-log",
        "audit",
        "versioning",
        "rollback",
        "admin-panel"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/tikhomirov/moontrail",
        "issues": "https://github.com/tikhomirov/moontrail/issues"
    },
    "require": {
        "php": "^8.2",
        "moonshine/moonshine": "^4.8"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Required when using the 'spatie' or 'auto' activity logger (^4.7)"
    },
    "require-dev": {
        "spatie/laravel-activitylog": "^4.7",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MoonShine\\MoonTrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoonShine\\MoonTrail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MoonShine\\MoonTrail\\MoonTrailServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest -c phpunit.xml.dist",
        "test:coverage": "./vendor/bin/pest -c phpunit.xml.dist --coverage",
        "test:types": "./vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
        "lint": "./vendor/bin/pint",
        "lint:test": "./vendor/bin/pint --test",
        "refactor": "./vendor/bin/rector process",
        "refactor:test": "./vendor/bin/rector process --dry-run",
        "ci": [
            "@refactor:test",
            "@lint:test",
            "@test:types",
            "@test"
        ],
        "ci:fix": [
            "@refactor",
            "@lint"
        ]
    }
}